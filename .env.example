# TradePay Environment Configuration Template
# Copy this file to .env and configure the values for your environment.

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Authentication & Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Server-only. Used for the authoritative state snapshot; never expose it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Durable server state. Set to "supabase" to persist the ledger snapshot in the
# service-role-only tradepay_state table. Required on free Render instances,
# which do not have a persistent disk. Leave unset for local file storage.
TRADEPAY_STATE_BACKEND=
# Optional row id when one Supabase project serves multiple environments.
TRADEPAY_STATE_ID=primary

# Administration (Comma-separated user UUIDs)
ADMIN_USER_IDS=

# Admin console secret. Required in production and must be at least 32 random
# characters. Generate one with: openssl rand -hex 32
# The server rejects the old dev780@$$ default and refuses to start in
# production without a valid key.
ADMIN_KEY=

# Payment Webhook HMAC Verification Secret
PAYMENT_WEBHOOK_SECRET=

# Feature Flags
ALLOW_SIMULATION=true
ALLOW_AUTO_DEPOSIT=false
CORS_ORIGINS=
